# Copy these names into Vercel Environment Variables.
# Never put real secrets into git.

# Discord OAuth login
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
DISCORD_GUILD_ID=
ADMIN_DISCORD_ID=
AUTH_SECRET=

# Supabase backend
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Discord integrations
DISCORD_BOT_TOKEN=
DISCORD_ANNOUNCEMENT_CHANNEL_ID=
DISCORD_WIKI_WEBHOOK_URL=

# Optional public URL for Discord announcements
NEXT_PUBLIC_SITE_URL=https://zyneaty-wiki.vercel.app

# Legacy/optional Prisma database URL. The live app currently uses Supabase.
DATABASE_URL=

